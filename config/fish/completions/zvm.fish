# zvm fish shell completion

function __fish_zvm_no_subcommand --description 'Test if there has been any subcommand yet'
    for i in (commandline -opc)
        if contains -- $i install i use run list-remote ls-remote list ls uninstall rm clean upgrade mirrorlist version vmu help h completion
            return 1
        end
    end
    return 0
end

complete -c zvm -n '__fish_zvm_no_subcommand' -f -l color -r -d 'enable (on, yes/y, enabled, true) or disable (off, no/n, disabled, false) colored ZVM output'
complete -c zvm -n '__fish_zvm_no_subcommand' -f -l help -s h -d 'show help'
complete -c zvm -n '__fish_zvm_no_subcommand' -f -l version -s v -d 'print the version'
complete -c zvm -n '__fish_zvm_no_subcommand' -xa '(zvm --generate-shell-completion 2>/dev/null)'
complete -x -c zvm -n '__fish_zvm_no_subcommand' -a 'install' -d 'Download and install a version of Zig'
complete -c zvm -n '__fish_seen_subcommand_from install i' -f -l zls -d 'install ZLS'
complete -c zvm -n '__fish_seen_subcommand_from install i' -f -l force -s f -d 'force installation even if the version is already installed'
complete -c zvm -n '__fish_seen_subcommand_from install i' -f -l skip-shasum -s s -d 'skip SHA-256 verification and the unverified-download confirmation'
complete -c zvm -n '__fish_seen_subcommand_from install i' -f -l full -d 'use the \'full\' zls compatibility mode'
complete -c zvm -n '__fish_seen_subcommand_from install i' -f -l nomirror -d 'download Zig from ziglang.org instead of a community mirror'
complete -c zvm -n '__fish_seen_subcommand_from install i' -f -l target-os -r -d 'override the target operating system (e.g., linux, macos, windows, freebsd)'
complete -c zvm -n '__fish_seen_subcommand_from install i' -f -l target-arch -r -d 'override the target architecture (e.g., x86_64, aarch64, arm, riscv64)'
